DB_USER=postgres
DB_PASS=postgres
RETAILY_DB_PASSWORD=
DB_NAME=pos_server_dev
PORT=4000
# Public Phoenix origin used by the Tauri bundle. Include http(s) and any port,
# but omit a trailing /api path. Example: https://api.example.com. When unset,
# Tauri derives it from GOOGLE_REDIRECT_URI during its build.
PHOENIX_SERVER_DNS=
# Required by Google OAuth.
GOOGLE_CLIENT=
GOOGLE_KEY=
# Exact callback URI registered in Google Cloud. Leave empty to derive it from
# the Phoenix endpoint URL (PHX_HOST in production).
GOOGLE_REDIRECT_URI=
# Required by the separate Phoenix admin area authentication.
ADMIN_USER=
ADMIN_PASWORD=


# FE signature verification: XMLSec executable and comma-separated PEM paths.
FE_XMLSEC_PATH=/opt/homebrew/bin/xmlsec1
# PKCS#12 reading for TigooServer.Sign (use /usr/bin/openssl on Ubuntu).
FE_OPENSSL_PATH=/opt/homebrew/opt/openssl@3/bin/openssl
FE_TRUSTED_CERTIFICATES=/Users/beltre.wilton/apps/tigoo-app/fe/digifirma-ca-raiz.crt
FE_INTERMEDIATE_CERTIFICATES=/Users/beltre.wilton/apps/tigoo-app/fe/digifirma-ca-subordinada-1.crt
FE_CERTIFICATE_CRLS=

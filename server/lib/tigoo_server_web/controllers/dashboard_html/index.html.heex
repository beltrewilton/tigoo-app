<.pos_layout
  id="dashboard-page"
  class="pos-shell invoice-view"
  active_page={:dashboard}
  scope={@scope}
  stores={@stores}
  store_id={@store_id}
  aria-labelledby="dashboard-title"
>
  <section class="catalog-panel">
    <div class="dashboard-content">
      <section class="dashboard-intro" aria-labelledby="welcome-title">
        <div>
          <h2 id="welcome-title">Welcome back, {@user.name}</h2>
          <p data-i18n="dashboard.manageAccount">Manage your account confirmation and workspace setup.</p>
        </div>
        <img
          :if={@company && is_binary(@company.brand_logo) && @company.brand_logo != ""}
          class="dashboard-brand-logo"
          src={@company.brand_logo}
          alt=""
        />
      </section>

      <section class="dashboard-summary-grid" aria-label="Account summary" data-i18n-aria-label="dashboard.accountSummary">
        <article class="card dashboard-summary-card">
          <div class="card-header">
            <p class="card-description" data-i18n="dashboard.accountStatus">Account status</p>
            <h2 class="card-title">
              <span data-i18n={if @user.confirmed_at, do: "invoice.confirmed", else: "dashboard.awaitingConfirmation"}>{if @user.confirmed_at, do: "Confirmed", else: "Awaiting confirmation"}</span>
            </h2>
          </div>
          <div class="card-content">
            <span class="status-badge" data-confirmed={not is_nil(@user.confirmed_at)}>
              <i></i><span data-i18n={if @user.confirmed_at, do: "dashboard.ready", else: "dashboard.pendingReview"}>{if @user.confirmed_at, do: "Ready", else: "Pending review"}</span>
            </span>
          </div>
        </article>
        <article class="card dashboard-summary-card">
          <div class="card-header">
            <p class="card-description" data-i18n="dashboard.workspace">Workspace</p>
            <h2 class="card-title">
              <span data-i18n={if @workspace_created?, do: nil, else: "dashboard.notCreated"}>{if @workspace_created?, do: workspace_name(@company, @user), else: "Not created"}</span>
            </h2>
          </div>
          <div class="card-content">
            <p class="dashboard-summary-detail">
              <span data-i18n={if @workspace_created?, do: nil, else: "dashboard.createAfterConfirmation"}>{if @workspace_created?, do: @user.tenant, else: "Create it after confirmation"}</span>
            </p>
          </div>
        </article>
      </section>

      <section
        :if={@scope.actor == :admin and is_nil(@user.confirmed_at)}
        class="card dashboard-panel"
        aria-labelledby="confirmation-title"
      >
        <div class="card-header">
          <h2 class="card-title" id="confirmation-title" data-i18n="dashboard.confirmationPending">Confirmation pending</h2>
          <p class="card-description" data-i18n="dashboard.awaitingAdmin">
            Your account is awaiting confirmation from an administrator.
          </p>
        </div>
        <div class="card-content">
          <div class="alert" role="alert">
            <svg
              class="alert-icon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" />
            </svg>
            <div class="alert-content">
              <h3 class="alert-title" data-i18n="dashboard.noActionNeeded">No action needed</h3>
              <p class="alert-description" data-i18n="dashboard.createWhenConfirmed">
                You’ll be able to create a workspace once your account is confirmed.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section
        :if={@scope.actor == :admin and @user.confirmed_at && is_nil(@user.tenant)}
        class="card dashboard-panel"
        aria-labelledby="tenant-setup-title"
      >
        <div class="card-header">
          <h2 class="card-title" id="tenant-setup-title" data-i18n="dashboard.createWorkspace">Create workspace</h2>
          <p class="card-description" data-i18n="dashboard.setupWorkspace">Set up the company workspace for this account.</p>
        </div>
        <form
          id="workspace-setup-form"
          class="card-content"
          action={~p"/pos/dashboard/tenant"}
          method="post"
          data-submitting-label="Creating workspace..."
        >
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div class="form-grid dashboard-form-grid">
            <div
              class="form-field"
              data-invalid={@company_form[:company_name].errors != [] || nil}
            >
              <label class="label" for={@company_form[:company_name].id} data-i18n="dashboard.companyName">Company name</label>
              <input
                class="input"
                id={@company_form[:company_name].id}
                name={@company_form[:company_name].name}
                type="text"
                value={@company_form[:company_name].value}
                required
                aria-invalid={
                  if @company_form[:company_name].errors == [], do: "false", else: "true"
                }
              />
              <p
                :for={{message, _} <- @company_form[:company_name].errors}
                class="field-error"
                role="alert"
              >
                {message}
              </p>
            </div>
            <div class="form-field" data-invalid={@tenant_form[:tenant].errors != [] || nil}>
              <label class="label" for={@tenant_form[:tenant].id} data-i18n="dashboard.workspaceId">Workspace ID</label>
              <input
                class="input"
                id={@tenant_form[:tenant].id}
                name={@tenant_form[:tenant].name}
                type="text"
                value={@tenant_form[:tenant].value}
                required
                autocomplete="off"
                aria-describedby="tenant-help"
                aria-invalid={if @tenant_form[:tenant].errors == [], do: "false", else: "true"}
              />
              <p class="field-description" id="tenant-help">
                <span data-i18n="admin.workspaceHelp">Lowercase letters, numbers, and underscores only.</span>
              </p>
              <p
                :for={{message, _} <- @tenant_form[:tenant].errors}
                class="field-error"
                role="alert"
              >
                {message}
              </p>
            </div>
            <div class="form-field">
              <label class="label" for={@company_form[:rnc].id}>
                RNC <span aria-hidden="true">(optional)</span>
              </label>
              <input
                class="input"
                id={@company_form[:rnc].id}
                name={@company_form[:rnc].name}
                type="text"
                value={@company_form[:rnc].value}
              />
            </div>
          </div>
          <div class="form-actions dashboard-form-actions">
            <button class="btn" data-variant="default" type="submit">
              <span data-submit-label data-i18n="dashboard.createWorkspace">Create workspace</span>
            </button>
          </div>
        </form>
      </section>

      <section
        :if={@workspace_created?}
        class="card dashboard-panel"
        aria-labelledby="workspace-summary-title"
      >
        <div class="card-header">
          <h2 class="card-title" id="workspace-summary-title" data-i18n="dashboard.workspaceDetails">Workspace details</h2>
          <p class="card-description" data-i18n="dashboard.activeWorkspace">Your active company workspace.</p>
        </div>
        <div class="card-content dashboard-detail-grid">
          <div>
            <p class="dashboard-detail-label" data-i18n="company.company">Company</p>
            <p class="dashboard-detail-value">{workspace_name(@company, @user)}</p>
          </div>
          <div>
            <p class="dashboard-detail-label" data-i18n="dashboard.workspaceId">Workspace ID</p>
            <p class="dashboard-detail-value">{@user.tenant}</p>
          </div>
          <div>
            <p class="dashboard-detail-label">RNC</p>
            <p class="dashboard-detail-value"><span data-i18n={if company_field(@company, :rnc), do: nil, else: "dashboard.notProvided"}>{company_field(@company, :rnc, "Not provided")}</span></p>
          </div>
        </div>
      </section>

      <section
        :if={@workspace_created?}
        class="card dashboard-panel"
        aria-labelledby="company-logo-title"
      >
        <div class="card-header">
          <h2 class="card-title" id="company-logo-title">Company logo</h2>
          <p class="card-description">Upload the logo shown on the dashboard and login screen.</p>
        </div>
        <form id="company-logo-form" class="card-content" action={~p"/pos/dashboard/logo"} method="post">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div
            id="company-logo-dropzone"
            class="product-image-dropzone company-logo-dropzone"
            tabindex="0"
            role="button"
            aria-describedby="company-logo-help"
          >
            <img
              id="company-logo-preview"
              class="product-image-preview company-logo-preview"
              src={company_field(@company, :brand_logo)}
              alt="Company logo preview"
              hidden={!is_binary(company_field(@company, :brand_logo)) || company_field(@company, :brand_logo) == ""}
            /><label class="label" for="company-logo">Logo upload</label>
            <p id="company-logo-help" class="field-description">
              Drop an image here or choose a file (max 10 MB). It will be resized and stored as Base64.
            </p>
            <input id="company-logo" class="input" type="file" accept="image/*" /><input
              id="company-brand-logo"
              name="company[brand_logo]"
              type="hidden"
              value={company_field(@company, :brand_logo)}
            />
          </div>
          <div class="form-actions dashboard-form-actions">
            <button class="btn" data-variant="default" type="submit">Save logo</button>
          </div>
        </form>
      </section>
    </div>
  </section>
</.pos_layout>

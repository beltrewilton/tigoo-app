<.pos_layout
  id="addons-install-page"
  class="pos-shell invoice-view"
  active_page={:addons}
  scope={@scope}
  stores={@stores}
  store_id={@store_id}
  aria-labelledby="addons-title"
>
  <section class="catalog-panel">
    <header class="dashboard-header">
      <div>
        <p class="dashboard-kicker" data-i18n="addons.extensions">Extensions</p>
        <h1 id="addons-title" data-i18n="addons.apps">Apps</h1>
      </div>
    </header>
    <div class="dashboard-content">
      <section class="addons-catalog" aria-labelledby="catalog-title">
        <div class="addons-catalog-heading">
          <div>
            <h2 id="catalog-title" data-i18n="addons.availableApps">Available apps</h2>
            <p data-i18n="addons.catalogCopy">Extend your workspace with server-managed business tools.</p>
          </div>
          <span class="addons-count">{length(@catalog)} <span data-i18n="addons.available">available</span></span>
        </div>
        <div class="addons-grid">
          <article :for={addon <- @catalog} class="card addon-card">
            <div class="card-header addon-card-header">
              <span class="addon-icon" aria-hidden="true">{addon.icon}</span>
              <div>
                <h3 class="card-title">{addon.name}</h3>
                <p class="addon-technical-name">{addon.identifier}</p>
              </div>
              <span
                :if={Enum.any?(@installed, &(&1.identifier == addon.identifier))}
                class="addon-installed"
              >
                <span data-i18n="addons.installed">Installed</span>
              </span>
            </div>
            <div class="card-content addon-card-content">
              <p>{addon.description}</p>
            </div>
            <div class="card-footer addon-card-footer">
              <form
                :if={not Enum.any?(@installed, &(&1.identifier == addon.identifier))}
                action={~p"/pos/addons/install"}
                method="post"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="identifier" value={addon.identifier} />
                <button class="btn" data-variant="default" data-size="sm" type="submit">
                  <span data-i18n="addons.install">Install</span>
                </button>
              </form>
              <form
                :if={Enum.any?(@installed, &(&1.identifier == addon.identifier))}
                action={"/addons/#{addon.identifier}/uninstall"}
                method="post"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <button class="btn" data-variant="outline" data-size="sm" type="submit">
                  <span data-i18n="addons.uninstall">Uninstall</span>
                </button>
              </form>
            </div>
          </article>
        </div>
      </section>
    </div>
  </section>
</.pos_layout>

<.pos_layout
  id="installed-addons-page"
  class="pos-shell invoice-view"
  active_page={:installed_addons}
  scope={@scope}
  stores={@stores}
  store_id={@store_id}
  aria-labelledby="installed-addons-title"
>
  <section class="catalog-panel">
    <header class="dashboard-header">
      <div>
        <p class="dashboard-kicker" data-i18n="addons.extensions">Extensions</p>
        <h1 id="installed-addons-title" data-i18n="addons.installedAddons">ADDONS INSTALADOS</h1>
      </div>
    </header>
    <div class="dashboard-content">
      <section class="addons-catalog" aria-labelledby="installed-addons-title">

        <div :if={@installed != []} class="installed-addons-grid">
          <a
            :for={addon <- @installed}
            class="installed-addon-card"
            href={
              if @store_id,
                do: "/pos/addons/#{addon.identifier}?#{URI.encode_query(%{"store_id" => @store_id})}",
                else: "/pos/addons/#{addon.identifier}"
            }
          >
            <span class="addon-icon installed-addon-icon" aria-hidden="true">{addon.icon}</span>
            <span class="installed-addon-name">{addon.name}</span>
          </a>
        </div>

        <div :if={@installed == []} class="card dashboard-panel">
          <div class="card-header">
            <h2 class="card-title" data-i18n="addons.noInstalledAddons">No add-ons installed</h2>
            <p class="card-description" data-i18n="addons.noInstalledAddonsCopy">
              Install add-ons from the app catalog to access them here.
            </p>
          </div>
          <div :if={TigooServer.Accounts.Scope.allowed?(@scope, "pos.addons.install")} class="card-footer">
            <a
              class="btn"
              data-variant="default"
              href={
                if @store_id,
                  do: "/pos/addons/install?#{URI.encode_query(%{"store_id" => @store_id})}",
                  else: "/pos/addons/install"
              }
            >
              <span data-i18n="dashboard.installAddon">Install Addons</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>
</.pos_layout>

                <path d="M32.3125 31.3333L34.114 32.886C34.8713 33.5387 35.25 33.8652 35.25 34.2708C35.25 34.6763 34.8713 35.0028 34.114 35.6555L32.3125 37.2083" stroke="#1A1B1E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

<.page_shell>
  <canvas id="dots-canvas" aria-hidden="true"></canvas>
  <div id="content-wrapper">
    <.navbar class="navbar">
      <a href="#home" class="landing-brand" aria-label="tigoo: Inicio">
        <img src={~p"/images/tigoo.svg"} alt="tigoo" />
      </a>
      <div id="landing-mobile-navigation" class="nav-links">
        <a href="#home" class="active">Inicio</a>
        <a href="#pricing">Solución</a>
        <a href="#faq">Preguntas</a>
        <a href="#footer">Contacto</a>
      </div>
      <div class="social-icons">
        <a :if={is_nil(@current_user)} href={~p"/google_auth_url"} aria-label="Iniciar sesión">
          <svg class="landing-account-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path
              d="M4.4 10.1 18.7 4.6c.67-.26 1.25.16 1.03.94l-2.43 11.2c-.17.79-.78.98-1.43.61l-3.62-2.67-1.75 1.69c-.19.19-.36.35-.73.35l.26-3.69 6.72-6.07c.29-.26-.07-.41-.45-.15L8 12.05l-3.58-1.12c-.78-.24-.8-.78-.02-.99Z"
              fill="#088674"
            />
          </svg>
        </a>
        <details :if={@current_user} class="landing-account-menu">
          <summary aria-label="Abrir menú de cuenta">
            <img
              :if={
                is_binary(@current_user.google_picture_url) and
                  @current_user.google_picture_url != ""
              }
              class="landing-account-avatar"
              src={@current_user.google_picture_url}
              alt=""
              referrerpolicy="no-referrer"
            />
            <svg
              :if={
                is_nil(@current_user.google_picture_url) or @current_user.google_picture_url == ""
              }
              class="landing-account-icon"
              aria-hidden="true"
              viewBox="0 0 24 24"
            >
              <path
                d="M4.4 10.1 18.7 4.6c.67-.26 1.25.16 1.03.94l-2.43 11.2c-.17.79-.78.98-1.43.61l-3.62-2.67-1.75 1.69c-.19.19-.36.35-.73.35l.26-3.69 6.72-6.07c.29-.26-.07-.41-.45-.15L8 12.05l-3.58-1.12c-.78-.24-.8-.78-.02-.99Z"
                fill="#088674"
              />
            </svg>
          </summary>
          <div class="landing-account-menu-content">
            <a href={@profile_url}>Visita tu perfil</a>
            <form action={~p"/logout"} method="post">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <button type="submit" class="landing-logout">
                <svg
                  class="landing-account-menu-icon"
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M14 5h4v14h-4" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M11 17l4-5-4-5M15 12H4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Cerrar sesión
              </button>
            </form>
          </div>
        </details>
        <button
          class="menu-toggle"
          type="button"
          aria-label="Abrir menú de navegación"
          aria-controls="landing-mobile-navigation"
          aria-expanded="false"
        >
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
          >
            <path
              d="M20 12H10"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M20 5H4"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M20 19H4"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </.navbar>

    <.section class="hero" id="home">
      <div class="badge">
        <span class="dot"></span> Hecho para negocios que se mueven
      </div>
      <h1>
        <span>Factura electrónica </span><span class="gray">DGII</span> <br />
        <span>Controla todo </span><span class="gray">en un solo lugar.</span>
      </h1>
      <p>
        <img class="inline-tigoo-logo" src={~p"/images/tigoo.svg"} alt="tigoo" />
        conecta ventas, inventario y <span class="highlight">clientes</span>

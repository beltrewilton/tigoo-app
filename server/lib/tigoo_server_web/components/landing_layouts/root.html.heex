<!DOCTYPE html>
<html lang="es-DO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "tigoo"}</title>
    <meta
      name="description"
      content={
        assigns[:page_description] ||
          "Ventas, inventario y facturación electrónica para negocios que quieren avanzar."
      }
    />
    <link rel="canonical" href={"https://tigoo.app#{assigns[:canonical_path] || "/"}"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tigoo" />
    <meta property="og:title" content={assigns[:page_title] || "tigoo"} />
    <meta
      property="og:description"
      content={
        assigns[:page_description] ||
          "Ventas, inventario y facturación electrónica desde una sola solución."
      }
    />
    <meta property="og:url" content={"https://tigoo.app#{assigns[:canonical_path] || "/"}"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={assigns[:page_title] || "tigoo"} />
    <meta
      name="twitter:description"
      content={
        assigns[:page_description] ||
          "Ventas, inventario y facturación electrónica desde una sola solución."
      }
    />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/pwa/icons/favicon-32.png"} />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/pwa/icons/apple-touch-icon.png"} />
    <link
      rel="preload"
      href={~p"/landing/fonts/inter-latin-variable.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={~p"/landing/landing.css"} />
    <script defer src={~p"/landing/landing.js"}>
    </script>
  </head>
  <body class="landing-page-body">
    {@inner_content}
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta :if={pos_pwa_path?(assigns)} name="theme-color" content="#088674" />
    <.live_title default="tigoo" suffix="">
      {assigns[:page_title]}
    </.live_title>
    <script>
      try { const theme = localStorage.getItem("pos-theme"); if (theme === "nature-light" || theme === "nature-dark") document.documentElement.classList.add("theme-nature"); if (theme === "caffeine-light" || theme === "caffeine-dark") document.documentElement.classList.add("theme-caffeine"); if (theme === "bold-tech-light" || theme === "bold-tech-dark") document.documentElement.classList.add("theme-bold-tech"); if (theme === "doom-64-light" || theme === "doom-64-dark") document.documentElement.classList.add("theme-doom-64"); if (theme === "nature-dark" || theme === "caffeine-dark" || theme === "bold-tech-dark" || theme === "doom-64-dark") document.documentElement.classList.add("dark"); if (localStorage.getItem("pos-catalog-view") === "table") document.documentElement.classList.add("pos-catalog-view-table"); } catch {}
    </script>
    <link :if={pos_pwa_path?(assigns)} rel="manifest" href="/manifest.json" />
    <link
      :if={pos_pwa_path?(assigns)}
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={~p"/pwa/icons/favicon-32.png"}
    />
    <link :if={pos_pwa_path?(assigns)} rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <link
      :if={pos_pwa_path?(assigns)}
      rel="apple-touch-icon"
      sizes="180x180"
      href={~p"/pwa/icons/apple-touch-icon.png"}
    />
    <link rel="stylesheet" href={~p"/assets/ui/default-semantic-tokens.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/fonts/inter.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/fonts/nature.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/fonts/doom-64.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/nature-semantic-tokens.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/caffeine-semantic-tokens.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/bold-tech-semantic-tokens.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/doom-64-semantic-tokens.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/typography/typography.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/button/button.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/input/input.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/label/label.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/card/card.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/form/form.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/separator/separator.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/alert/alert.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/dialog/dialog.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/toast/toast.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/table/table.css"} />
    <link rel="stylesheet" href={~p"/assets/ui/components/select/select.css"} />
    <link rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="stylesheet" href={~p"/pos-client.css"} />
    <link rel="stylesheet" href={~p"/login-client.css"} />
    <link rel="stylesheet" href={~p"/assets/invoice-live-overrides.css"} />
    <link rel="stylesheet" href={~p"/assets/pos-live-overrides.css"} />
    <link rel="stylesheet" href={~p"/assets/purchase-orders-live.css"} />
    <script>
      if (new URLSearchParams(window.location.search).has("debug")) {
        const script = document.createElement("script");
        script.src = "https://cdn.jsdelivr.net/npm/eruda";
        script.onload = () => window.eruda?.init();
        document.head.appendChild(script);
      }
    </script>
    <script defer src={~p"/assets/inventory-product-image.js"}>
    </script>
    <script defer src={~p"/assets/company-settings-live.js"}>
    </script>
    <script defer src={~p"/assets/login-live.js"}>
    </script>
    <script type="module" src={~p"/assets/app.js"}>
    </script>
    <script defer src={~p"/assets/theme.js"}>
    </script>
  </head>
  <body>
    <div>{@inner_content}</div>
  </body>
</html>
